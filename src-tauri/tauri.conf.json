{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkTime",
  "version": "1.0.0",
  "identifier": "com.levgood.worktime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WorkTime — ניהול זמן עבודה",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "visible": true,
        "decorations": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Lev-Good",
    "copyright": "© 2026 WorkTime",
    "category": "Productivity",
    "shortDescription": "ניהול זמן עבודה קומפקטי",
    "longDescription": "WorkTime — מעקב שעות, לקוחות, פרויקטים, דוחות ותשלומים, ישירות משורת המשימות.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Hebrew", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
